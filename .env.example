# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional: override where uploads, the database and models live (default ./data)
# DATA_DIR=
# Optional: whisper.cpp model file (default ./data/models/ggml-base.en.bin)
# WHISPER_MODEL=
# Per-review spending cap in US dollars (default 3)
# REVIEW_COST_CAP_USD=3
# Spending protection (all optional; these are the defaults)
# DAILY_LIMIT_USD=10
# MONTHLY_LIMIT_USD=40
# MAX_REVIEWS_PER_DAY=8
# MAX_FOLLOWUPS_PER_REVIEW=20
# MAX_ANSWER_CHECKS_PER_HOUR=60
