# Your settings. `npm run setup` copies this to .env.local and fills in the API key.
# .env.local stays on your computer: it's never committed.

# Required: your Anthropic API key (console.anthropic.com → Settings → API Keys)
ANTHROPIC_API_KEY=

# Spending protection (optional; these are the defaults)
# DAILY_LIMIT_USD=10
# MONTHLY_LIMIT_USD=40
# REVIEW_COST_CAP_USD=3
# MAX_REVIEWS_PER_DAY=8
# MAX_FOLLOWUPS_PER_REVIEW=20
# MAX_ANSWER_CHECKS_PER_HOUR=60

# ---------------------------------------------------------------------------
# Optional: accounts with Supabase (see README "Optional: accounts with Supabase").
# Leave these out to run in local mode: no sign-in, everything stays on this computer.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# Your own Postgres or Supabase database. Leave out to use the built-in one (data/pg).
# DATABASE_URL=
# Your login email(s), comma-separated, to see the app's API spend on Your reviews
# OWNER_EMAILS=
# Ceilings for one network across all its accounts (defaults shown)
# MAX_REVIEWS_PER_NETWORK_PER_DAY=40
# MAX_ANSWER_CHECKS_PER_NETWORK_PER_HOUR=300

# Advanced (optional)
# DATA_DIR=          where media, the database and models live (default ./data)
# WHISPER_MODEL=     speech-to-text model file (default ./data/models/ggml-base.en.bin)
# PORT=              default 3000
# HOST=              default 127.0.0.1 (this computer only; keep it that way)
# TRUSTED_PROXIES= / CLIENT_IP_HEADER=   only if you run it behind a proxy
