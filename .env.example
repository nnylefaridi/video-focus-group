# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=

# Supabase (Project Settings in the Supabase dashboard; see README "Supabase setup")
# Project URL, and the publishable key (sb_publishable_...) from API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) from API Keys. Server only: used to store videos.
SUPABASE_SECRET_KEY=
# Database connection string: Connect > Session pooler (paste your database password into it)
DATABASE_URL=

# Optional: your login email(s), comma-separated, to also see the app's API spend on Your reviews
# OWNER_EMAILS=
# Per-person limits use the visitor's IP, read from the connection by server.mjs.
# When deployed: how many proxies in front of the app append to X-Forwarded-For (default 0)
# TRUSTED_PROXIES=
# ...or a header your host overwrites with the visitor's IP (e.g. cf-connecting-ip, fly-client-ip)
# CLIENT_IP_HEADER=
# Address to listen on (default 127.0.0.1: this computer only) and port (default 3000)
# HOST=
# PORT=

# Optional: override where working media files and models live (default ./data)
# DATA_DIR=
# Optional: whisper.cpp model file (default ./data/models/ggml-base.en.bin)
# WHISPER_MODEL=
# Per-review spending cap in US dollars (default 3)
# REVIEW_COST_CAP_USD=3
# App-wide spending caps (all optional; these are the defaults)
# DAILY_LIMIT_USD=10
# MONTHLY_LIMIT_USD=40
# Per-person limits: per account when signed in, per network (IP) when signed out (defaults shown)
# MAX_REVIEWS_PER_DAY=8
# MAX_FOLLOWUPS_PER_REVIEW=20
# MAX_ANSWER_CHECKS_PER_HOUR=60
# Ceilings for one network (school, office) across all its people (defaults shown)
# MAX_REVIEWS_PER_NETWORK_PER_DAY=40
# MAX_ANSWER_CHECKS_PER_NETWORK_PER_HOUR=300
