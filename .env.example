# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional: override where uploads, the database and models live (default ./data)
# DATA_DIR=
# Optional: whisper.cpp model file (default ./data/models/ggml-base.en.bin)
# WHISPER_MODEL=
# Per-review spending cap in US dollars (default 3)
# REVIEW_COST_CAP_USD=3
# Optional, only for the one-time character art script (npm run art)
# OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1
