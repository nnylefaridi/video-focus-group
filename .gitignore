# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# app data (uploads, database, models)
/data/

# test output
/tests/eval/out/
/test-results/
/playwright-report/

# source images for the reviewer stickers (kept locally, not tracked)
/Cutouts/
/cutouts.jpeg

# screen recordings and exported videos dropped in the project folder
/*.mp4
/*.mov
