{
  "name": "panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -H 127.0.0.1",
    "worker": "tsx --env-file-if-exists=.env.local worker/index.mts",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "lint:design": "tsx scripts/lint-design.mts",
    "kb:validate": "tsx scripts/kb-validate.mts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run lint:design && npm run kb:validate",
    "e2e": "playwright test",
    "eval": "tsx scripts/eval.mts",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke-review.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "better-sqlite3": "^13.0.3",
    "motion": "^14.3.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
